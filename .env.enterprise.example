# ── Cleo Enterprise Deployment Configuration ──────────────────────────────────
# Copy this file to .env.enterprise and configure for your environment:
#   cp .env.enterprise.example .env.enterprise

# ── 1. Ingress & Domain Settings ──────────────────────────────────────────────
# Public HTTPS URL of your n8n instance (used for Slack, Teams, GChat webhooks)
WEBHOOK_URL=https://cleo-bot.yourcompany.com
N8N_PROTOCOL=https
N8N_PORT=5678

# Generate a random 32-character key: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace_with_32_character_random_hex_key

# ── 2. PostgreSQL Credentials ────────────────────────────────────────────────
POSTGRES_USER=n8n_admin
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=n8n

# ── 3. Enterprise FinOps AI Engine ───────────────────────────────────────────
# Options: gemini (recommended for fast streaming), openai, anthropic
AI_ENGINE=gemini
GEMINI_API_KEY=AIzaSy...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── 4. CloudHealth Default Organization (Optional) ───────────────────────────
# If set, employees are automatically connected to this organization by default
# without needing to type a number or pick an org on their first prompt.
CLEO_DEFAULT_ORG_ID=crn:1001:organization/100000000001
CLEO_DEFAULT_ORG_NAME=Master Enterprise Production

# ── 5. Enterprise Chat Bot Credentials ───────────────────────────────────────
# Slack: From your Slack App (api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Microsoft Teams: From Azure Bot Framework registration
# TEAMS_APP_ID=your-microsoft-app-id
# TEAMS_APP_PASSWORD=your-microsoft-app-password

# ── 6. Logging & Debugging ───────────────────────────────────────────────────
CLEO_VERBOSE=0

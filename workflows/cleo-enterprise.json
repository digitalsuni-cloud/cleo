              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1240,
        20
      ],
      "id": "store-confirmed-org",
      "name": "Store Confirmed Org"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Classify this cloud cost question as 'simple' or 'complex'.\n\nSimple = direct lookup, one metric, one single month, one cloud, dataset discovery\nComplex = period-over-period trend, month-over-month variance, multi-cloud comparison, forecast, anomaly root-cause\n\nQuestion: {{ $('Load Session State').first().json.chatInput }}\n\nReply with ONE word only: simple or complex",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        1460,
        -100
      ],
      "id": "query-classifier",
      "name": "Query Classifier"
    },
    {
      "parameters": {
        "model": "gemini-1.5-flash",
        "options": {
          "temperature": 0
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        1460,
        100
      ],
      "id": "classifier-llm",
      "name": "Google Gemini Flash (Classifier)",
      "credentials": {
        "googlePalmApi": {
          "id": "",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "cond-simple",
              "leftValue": "={{ $json.text.toLowerCase() }}",
              "rightValue": "simple",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1680,
        -100
      ],
      "id": "check-complexity",
      "name": "Simple or Complex?"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Today: {{ $now.toFormat('yyyy-MM-dd') }}\nTenant: {{ $('Store Confirmed Org').first().json.orgName || $('Load Session State').first().json.orgName }}\nOrgId: {{ $('Store Confirmed Org').first().json.orgId || $('Load Session State').first().json.orgId }}\nQuestion: {{ $('Load Session State').first().json.chatInput }}",
        "options": {
          "systemMessage": "=You are Cleo, an enterprise FinOps AI assistant for {{ $('Store Confirmed Org').first().json.orgName || $('Load Session State').first().json.orgName }}.\n\nRules:\n1. Answer using live CloudHealth data via the execute_datasource_query MCP tool.\n2. Always pass orgId: \"{{ $('Store Confirmed Org').first().json.orgId || $('Load Session State').first().json.orgId }}\" in all tool calls.\n3. Never SELECT * — select specific columns explicitly.\n4. Format responses cleanly for Slack: use markdown tables, *bold* headers, and currency symbols ($).\n5. Keep outputs concise and factual.",
          "maxIterations": 15
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1920,
        -240
      ],
      "id": "cleo-fast-agent",
      "name": "Cleo Fast Agent",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Today: {{ $now.toFormat('yyyy-MM-dd') }}\nTenant: {{ $('Store Confirmed Org').first().json.orgName || $('Load Session State').first().json.orgName }}\nOrgId: {{ $('Store Confirmed Org').first().json.orgId || $('Load Session State').first().json.orgId }}\nQuestion: {{ $('Load Session State').first().json.chatInput }}",
        "options": {
          "systemMessage": "=You are Cleo Deep, an expert FinOps intelligence agent for {{ $('Store Confirmed Org').first().json.orgName || $('Load Session State').first().json.orgName }}. You handle complex multi-cloud, trend analysis, MoM cost variations, and forecasting.\n\nRules:\n1. Answer using live CloudHealth data via the execute_datasource_query MCP tool.\n2. Always pass orgId: \"{{ $('Store Confirmed Org').first().json.orgId || $('Load Session State').first().json.orgId }}\" in all tool calls.\n3. Perform step-by-step reasoning with the Think tool before formulating SQL.\n4. Format tables with Markdown, percentages (%), and MoM delta comparisons.\n5. Keep outputs structured and concise for Slack threads.",
          "maxIterations": 30
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1920,
        80
      ],
      "id": "cleo-deep-agent",
      "name": "Cleo Deep Agent",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "endpointUrl": "={{ $env.CLEO_BASE_URL || 'http://cleo:8080' }}/mcp",
        "options": {
          "timeout": 60000
        }
      },
      "type": "@n8n/n8n-nodes-langchain.mcpClientTool",
      "typeVersion": 1.2,
      "position": [
        2140,
        -80
      ],
      "id": "mcp-client-tool",
      "name": "CloudHealth MCP Service"
    },
    {
      "parameters": {
        "description": "Plan SQL queries, dataset selection, and multi-step approaches silently."
      },
      "type": "@n8n/n8n-nodes-langchain.toolThink",
      "typeVersion": 1.1,
      "position": [
        2140,
        40
      ],
      "id": "think-tool",
      "name": "Think Tool"
    },
    {
      "parameters": {},
      "type": "@n8n/n8n-nodes-langchain.toolCalculator",
      "typeVersion": 1,
      "position": [
        2140,
        160
      ],
      "id": "calculator-tool",
      "name": "Calculator Tool"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "fout-1",
              "name": "output",
              "value": "={{ $('Cleo Fast Agent').first()?.json?.output || $('Cleo Deep Agent').first()?.json?.output || $('Format Org Menu').first()?.json?.output || $('Parse Org Selection').first()?.json?.output || 'Cleo was unable to complete the query.' }}",
              "type": "string"
            },
            {
              "id": "fout-2",
              "name": "channel",
              "value": "={{ $('Load Session State').first().json.channel }}",
              "type": "string"
            },
            {
              "id": "fout-3",
              "name": "initialMessageTs",
              "value": "={{ $('Load Session State').first().json.initialMessageTs }}",
              "type": "string"
            },
            {
              "id": "fout-4",
              "name": "source",
              "value": "={{ $('Load Session State').first().json.source }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2420,
        -100
      ],
      "id": "prepare-output",
      "name": "Prepare Output"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "cond-is-slack",
              "leftValue": "={{ $json.source }}",
              "rightValue": "slack",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        2640,
        -100
      ],
      "id": "check-source",
      "name": "Is Slack Event?"
    },
    {
      "parameters": {
        "operation": "update",
        "channelId": {

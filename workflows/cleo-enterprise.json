      "typeVersion": 2.3,
      "position": [
        580,
        80
      ],
      "id": "check-awaiting",
      "name": "Awaiting Org Selection?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CLEO_BASE_URL || 'http://cleo:8080' }}/mcp",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"tools/call\",\n  \"params\": { \"name\": \"list_managed_orgs\", \"arguments\": {} },\n  \"id\": 1\n}",
        "options": {
          "timeout": 30000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        580,
        -240
      ],
      "id": "list-orgs",
      "name": "List Managed Orgs"
    },
    {
      "parameters": {
        "jsCode": "const mcpResponse = $input.first().json;\nlet orgs = [];\nlet isAuthError = false;\ntry {\n  if (mcpResponse.result && mcpResponse.result.isError) isAuthError = true;\n  const content = (mcpResponse.result || mcpResponse).content || [];\n  for (const item of content) {\n    if (item.type === 'text') {\n      if (item.text.includes('not authenticated') || item.text.includes('unauthorized') || item.text.includes('-32001')) {\n        isAuthError = true;\n      }\n      const parsed = JSON.parse(item.text);\n      orgs = Array.isArray(parsed) ? parsed : (parsed.organizations || parsed.data || []);\n    }\n  }\n} catch(e) {}\n\nconst state = $('Load Session State').first().json;\n\nif (isAuthError || orgs.length === 0) {\n  const msg = '⚠️ **CloudHealth MCP is not authenticated**\\n\\nPlease ensure the enterprise CloudHealth credentials are mounted at `/run/secrets/cleo-token/oauth_tokens.json`.\\n\\nType `/reset` once credentials are refreshed.';\n  return [{ json: { output: msg, orgList: [], awaitingOrgSelection: false, channel: state.channel, initialMessageTs: state.initialMessageTs, source: state.source } }];\n}\n\nlet menu = '👋 **Welcome to Cleo FinOps Assistant!**\\n\\nPlease reply with the **number** of the organization you want to query:\\n\\n';\norgs.forEach((org, i) => {\n  const name = org.name || org.orgName || org.displayName || `Org ${i+1}`;\n  const id = org.id || org.crn || org.orgId || '';\n  menu += `*${i+1}.* ${name}`;\n  if (id) menu += ` \\`${id}\\``;\n  menu += '\\n';\n});\nmenu += '\\n_Type `/reset` at any time to switch organizations._';\nreturn [{ json: { output: menu, orgList: orgs, awaitingOrgSelection: true, channel: state.channel, initialMessageTs: state.initialMessageTs, source: state.source } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800,
        -240
      ],
      "id": "format-org-menu",
      "name": "Format Org Menu"
    },
    {
      "parameters": {
        "jsCode": "const userInput = $('Load Session State').first().json.chatInput.trim();\nconst sessionData = $('Load Session State').first().json;\nconst orgList = sessionData.orgList || [];\nconst selection = parseInt(userInput, 10);\nif (isNaN(selection) || selection < 1 || selection > orgList.length) {\n  return [{\n    json: {\n      valid: false,\n      output: `⚠️ Please type a number between 1 and ${orgList.length} to select an organization.`,\n      orgList,\n      awaitingOrgSelection: true,\n      channel: sessionData.channel,\n      initialMessageTs: sessionData.initialMessageTs,\n      source: sessionData.source\n    }\n  }];\n}\nconst selected = orgList[selection - 1];\nconst orgName = selected.name || selected.orgName || selected.displayName || `Org ${selection}`;\nconst orgId = selected.id || selected.crn || selected.orgId;\nreturn [{\n  json: {\n    valid: true,\n    orgId,\n    orgName,\n    orgList,\n    awaitingOrgSelection: false,\n    channel: sessionData.channel,\n    initialMessageTs: sessionData.initialMessageTs,\n    source: sessionData.source,\n    output: `✅ *Connected to: ${orgName}*\\n\\nI'm ready for your CloudHealth FinOps queries in this thread. What would you like to know?\\n\\n_Examples:_\\n- What were our top 5 AWS services by cost last month?\\n- Show Azure monthly spend trends for Q3\\n- Compare AWS vs Azure costs this month`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        80
      ],
      "id": "parse-org-selection",
      "name": "Parse Org Selection"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [

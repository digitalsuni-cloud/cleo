    {
      "parameters": {
        "jsCode": "const userInput = $('Extract Input').first().json.chatInput.trim();\nconst sessionData = $('Load Session State').first().json;\nconst orgList = sessionData.orgList || [];\nconst selection = parseInt(userInput, 10);\nif (isNaN(selection) || selection < 1 || selection > orgList.length) {\n  return [{ json: { valid: false, message: `⚠️ Please type a number between 1 and ${orgList.length} to select a tenant.`, orgList, awaitingOrgSelection: true } }];\n}\nconst selected = orgList[selection - 1];\nconst orgName = selected.name || selected.orgName || selected.displayName || `Org ${selection}`;\nconst orgId = selected.id || selected.crn || selected.orgId;\nreturn [{ json: { valid: true, orgId, orgName, orgList, awaitingOrgSelection: false, confirmMessage: `✅ **Connected to: ${orgName}**\\n\\nI'm ready to answer your CloudHealth cost questions. What would you like to know?\\n\\n_Examples:_\\n- What are my top 5 AWS services by cost this month?\\n- Show me Azure spending trends for the last 3 months?\\n- Which region had the highest EC2 spend in August?` } }];"
      },

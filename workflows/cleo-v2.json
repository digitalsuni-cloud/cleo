    {
      "parameters": {
        "jsCode": "const mcpResponse = $input.first().json;\nlet orgs = [];\nlet isAuthError = false;\ntry {\n  if (mcpResponse.result && mcpResponse.result.isError) {\n    isAuthError = true;\n  }\n  const content = (mcpResponse.result || mcpResponse).content || [];\n  for (const item of content) {\n    if (item.type === 'text') {\n      if (item.text.includes('not authenticated') || item.text.includes('unauthorized') || item.text.includes('-32001')) {\n        isAuthError = true;\n      }\n      const parsed = JSON.parse(item.text);\n      orgs = Array.isArray(parsed) ? parsed : (parsed.organizations || parsed.data || []);\n    }\n  }\n} catch(e) {}\n\nif (isAuthError || orgs.length === 0) {\n  const msg = '⚠️ **CloudHealth is not authenticated**\\n\\nPlease connect your CloudHealth account via the Cleo Web UI at **http://127.0.0.1:8080** first.\\n\\nOnce authenticated, type `/reset` to load your live tenants.';\n  return [{ json: { orgList: [], menuMessage: msg, awaitingOrgSelection: false } }];\n}\n\nlet menu = '👋 **Welcome to Cleo — Cloud Efficiency Optimizer!**\\n\\nPlease type the **number** of the tenant you want to query:\\n\\n';\norgs.forEach((org, i) => {\n  const name = org.name || org.orgName || org.displayName || `Org ${i+1}`;\n  const id = org.id || org.crn || org.orgId || '';\n  menu += `**${i+1}.** ${name}`;\n  if (id) menu += ` \\`${id}\\``;\n  menu += '\\n';\n});\nmenu += '\\n_Type `/reset` at any time to switch tenants._';\nreturn [{ json: { orgList: orgs, menuMessage: menu, awaitingOrgSelection: true } }];"
      },
      "type": "n8n-nodes-base.code",
